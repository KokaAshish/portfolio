---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => !data.hidden);
projects.sort((a, b) => b.data.year - a.data.year);

type ProjectData = {
  title: string;
  summary: string;
  problem: string;
  outcome: string;
  tags: string[];
  year: number;
  github: string | null;
  link: string | null;
  slug: string;
  featured: boolean;
};

const projectData: ProjectData[] = projects.map((p) => ({
  title:    p.data.title,
  summary:  p.data.summary,
  problem:  p.data.problem,
  outcome:  p.data.outcome,
  tags:     p.data.tags,
  year:     p.data.year,
  github:   p.data.github ?? null,
  link:     p.data.link ?? null,
  slug:     p.slug,
  featured: p.data.featured,
}));
---

<BaseLayout
  title="Ashish Koka"
  description="Ashish Koka — Tech Enthusiast, Software Engineer, and ML Researcher based in Cincinnati, OH. I build thoughtful software that solves real problems."
>
  <!-- ─── HERO ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="section-label reveal">Hello, I'm</span>
        <h1 class="hero__name reveal reveal-delay-1">
          Ashish <span class="gradient-text">Koka.</span>
        </h1>
        <p class="hero__tagline reveal reveal-delay-2">
          Tech Enthusiast &nbsp;·&nbsp; Software Engineer &nbsp;·&nbsp; ML Researcher
        </p>
        <p class="hero__description reveal reveal-delay-3">
          I'm a Computer Science graduate student at the University of Cincinnati who genuinely enjoys
          building things — from C-level systems to full-stack analytics platforms. I dig into problems
          below the abstraction layer, ship clean code, and care about the boring parts that make
          software actually reliable.
        </p>
        <p class="hero__description hero__description--sub reveal reveal-delay-3">
          If you're looking for someone who'll read the original paper before implementing the
          algorithm, won't blame the framework, and gets things done — we'll get along well.
        </p>
        <div class="hero__actions reveal reveal-delay-4">
          <a href="/projects" class="btn btn-primary">See my work</a>
          <a href="/contact" class="btn btn-ghost">Get in touch</a>
        </div>
      </div>

      <aside class="hero__status reveal reveal-delay-2" aria-label="Current status">
        <div class="status-card card">
          <div class="status-card__dot" aria-hidden="true"></div>
          <span class="status-card__label">Currently</span>
          <strong class="status-card__main">Building &amp; Learning</strong>
          <span class="status-card__detail">ME Computer Science<br/>University of Cincinnati</span>
          <div class="status-card__divider"></div>
          <ul class="status-card__interests">
            <li>Data Engineering</li>
            <li>Systems Programming</li>
            <li>Machine Learning</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- ─── PROJECTS GRID ─────────────────────────────────────────── -->
  <section class="projects-section">
    <div class="container">
      <div class="section-header">
        <span class="section-label reveal">Projects</span>
        <h2 class="section-title reveal reveal-delay-1">Things I've built</h2>
        <p class="section-sub reveal reveal-delay-2">
          Click any tile to see details — what the problem was, what shipped, and the tech behind it.
        </p>
      </div>

      <div class="projects-grid" id="projects-grid">
        {projectData.map((p, i) => (
          <button
            class={`project-tile card reveal reveal-delay-${(i % 3) + 1}`}
            data-project={JSON.stringify(p)}
            aria-haspopup="dialog"
            type="button"
          >
            <div class="project-tile__top">
              <span class="tag">{p.year}</span>
              {p.featured && <span class="project-tile__featured">Featured</span>}
            </div>
            <h3 class="project-tile__title">{p.title}</h3>
            <p class="project-tile__summary">
              {p.summary.length > 110 ? p.summary.slice(0, 110) + '…' : p.summary}
            </p>
            <div class="project-tile__tags">
              {p.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
              {p.tags.length > 3 && <span class="tag">+{p.tags.length - 3}</span>}
            </div>
            <div class="project-tile__cta" aria-hidden="true">View details →</div>
          </button>
        ))}
      </div>

      <div class="projects-all reveal">
        <a href="/projects" class="btn btn-ghost">All case studies →</a>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT CTA ─────────────────────────────────────────────── -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card card reveal">
        <div class="cta-card__body">
          <span class="section-label">Ready to collaborate?</span>
          <h2 class="cta-card__title">Let's build something that matters.</h2>
          <p class="cta-card__text">
            Open to interesting problems, internships, and full-time roles. Based in Cincinnati, OH —
            always working on something and happy to talk shop.
          </p>
          <div class="cta-card__actions">
            <a href="/about" class="btn btn-primary">Read my story</a>
            <a href="/contact" class="btn btn-ghost">Say hello</a>
          </div>
        </div>
        <div class="cta-card__stats" aria-hidden="true">
          <div class="stat-item">
            <span class="stat-item__num gradient-text">6+</span>
            <span class="stat-item__label">Projects shipped</span>
          </div>
          <div class="stat-item">
            <span class="stat-item__num gradient-text">1</span>
            <span class="stat-item__label">IEEE publication</span>
          </div>
          <div class="stat-item">
            <span class="stat-item__num gradient-text">2</span>
            <span class="stat-item__label">Internships</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PROJECT DETAIL MODAL ──────────────────────────────────── -->
  <dialog id="project-modal" class="project-modal" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-inner">
      <button id="modal-close" class="modal-close" aria-label="Close dialog" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <header class="modal-header">
        <div class="modal-meta">
          <span id="modal-year" class="tag"></span>
          <div id="modal-tags" class="modal-tags"></div>
        </div>
        <h2 id="modal-title" class="modal-title"></h2>
      </header>

      <div class="modal-body">
        <p id="modal-summary" class="modal-summary"></p>

        <div class="modal-section">
          <h3 class="modal-section-heading">The Problem</h3>
          <p id="modal-problem"></p>
        </div>

        <div class="modal-section">
          <h3 class="modal-section-heading">The Outcome</h3>
          <p id="modal-outcome"></p>
        </div>
      </div>

      <footer class="modal-footer">
        <div id="modal-links" class="modal-links"></div>
        <a id="modal-casestudy" href="#" class="btn btn-primary">Full case study →</a>
      </footer>
    </div>
  </dialog>
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────── */
  .hero {
    padding-top: var(--space-24);
    padding-bottom: var(--space-16);
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-16);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-8); }
    .hero { min-height: auto; padding-top: var(--space-16); }
  }

  .hero__name {
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-block: var(--space-3) var(--space-4);
  }

  .hero__tagline {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-6);
  }

  .hero__description {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    max-width: 560px;
    margin-bottom: var(--space-4);
  }
  .hero__description--sub {
    font-size: var(--text-base);
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Status card */
  .hero__status { position: relative; }

  .status-card {
    position: relative;
    padding: var(--space-6);
  }

  .status-card__dot {
    width: 8px;
    height: 8px;
    background: #28c840;
    border-radius: 50%;
    box-shadow: 0 0 10px #28c84070;
    margin-bottom: var(--space-3);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .status-card__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-1);
  }

  .status-card__main {
    display: block;
    font-size: var(--text-lg);
    font-weight: var(--weight-semi);
    color: var(--text);
    margin-bottom: var(--space-2);
  }

  .status-card__detail {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-4);
  }

  .status-card__divider {
    height: 1px;
    background: var(--border);
    margin-bottom: var(--space-4);
  }

  .status-card__interests {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .status-card__interests li {
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding-left: var(--space-3);
    position: relative;
  }
  .status-card__interests li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.6em;
    top: 0.35em;
  }

  /* ── Projects Section ──────────────────────────────────────────── */
  .projects-section { padding-block: var(--space-24); }

  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    margin-block: var(--space-3) var(--space-3);
  }

  .section-sub {
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    max-width: 480px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  @media (max-width: 900px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .projects-grid { grid-template-columns: 1fr; }
  }

  .project-tile {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    text-align: left;
    width: 100%;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--duration) var(--ease),
                box-shadow var(--duration) var(--ease),
                transform var(--duration) var(--ease);
  }
  .project-tile:hover {
    border-color: var(--border-glow);
    box-shadow: var(--shadow-card), 0 0 32px var(--accent-glow);
    transform: translateY(-3px);
  }
  .project-tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .project-tile__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .project-tile__featured {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0 var(--space-2);
    border-radius: 100px;
  }

  .project-tile__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semi);
    color: var(--text);
    line-height: var(--leading-tight);
  }

  .project-tile__summary {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    flex: 1;
  }

  .project-tile__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-tile__cta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .projects-all {
    text-align: center;
    margin-top: var(--space-4);
  }

  /* ── CTA Section ───────────────────────────────────────────────── */
  .cta-section { padding-block: 0 var(--space-24); }

  .cta-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-12);
  }
  @media (max-width: 768px) {
    .cta-card { grid-template-columns: 1fr; gap: var(--space-8); padding: var(--space-8); }
  }

  .cta-card__title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    margin-block: var(--space-3) var(--space-4);
  }

  .cta-card__text {
    color: var(--text-muted);
    line-height: var(--leading-loose);
    max-width: 480px;
    margin-bottom: var(--space-6);
  }

  .cta-card__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta-card__stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 140px;
  }
  @media (max-width: 768px) {
    .cta-card__stats { flex-direction: row; flex-wrap: wrap; }
  }

  .stat-item { text-align: center; }
  .stat-item__num {
    display: block;
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: var(--space-1);
  }
  .stat-item__label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Modal ─────────────────────────────────────────────────────── */
  .project-modal {
    /* Force center on screen in all browsers */
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;

    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    color: var(--text);
    padding: 0;
    max-width: min(680px, 95vw);
    width: 100%;
    max-height: 90vh;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0,0,0,0.6), 0 0 0 1px var(--border);
  }

  .project-modal::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .project-modal[open] {
    display: flex;
    flex-direction: column;
  }

  .modal-inner {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    max-height: 90vh;
    padding: var(--space-8);
    gap: var(--space-6);
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all var(--duration) var(--ease);
    flex-shrink: 0;
  }
  .modal-close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .modal-header { padding-right: var(--space-10); }

  .modal-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .modal-title {
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .modal-summary {
    color: var(--text-muted);
    line-height: var(--leading-loose);
    font-size: var(--text-base);
  }

  .modal-section {
    border-left: 2px solid var(--accent);
    padding-left: var(--space-4);
  }

  .modal-section-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .modal-section p {
    color: var(--text-muted);
    line-height: var(--leading-loose);
    font-size: var(--text-sm);
  }

  .modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .modal-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .modal-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    transition: all var(--duration) var(--ease);
  }
  .modal-links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  const modal    = document.getElementById('project-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('modal-close')   as HTMLButtonElement;

  const elYear       = document.getElementById('modal-year')       as HTMLElement;
  const elTags       = document.getElementById('modal-tags')       as HTMLElement;
  const elTitle      = document.getElementById('modal-title')      as HTMLElement;
  const elSummary    = document.getElementById('modal-summary')    as HTMLElement;
  const elProblem    = document.getElementById('modal-problem')    as HTMLElement;
  const elOutcome    = document.getElementById('modal-outcome')    as HTMLElement;
  const elLinks      = document.getElementById('modal-links')      as HTMLElement;
  const elCaseStudy  = document.getElementById('modal-casestudy') as HTMLAnchorElement;

  function openModal(data: {
    title: string;
    summary: string;
    problem: string;
    outcome: string;
    tags: string[];
    year: number;
    github: string | null;
    link: string | null;
    slug: string;
  }) {
    elYear.textContent    = String(data.year);
    elTitle.textContent   = data.title;
    elSummary.textContent = data.summary;
    elProblem.textContent = data.problem;
    elOutcome.textContent = data.outcome;

    elTags.innerHTML = data.tags
      .map((t) => `<span class="tag">${t}</span>`)
      .join('');

    const links: string[] = [];
    if (data.github) {
      links.push(
        `<a href="${data.github}" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub ↗
        </a>`
      );
    }
    if (data.link) {
      links.push(
        `<a href="${data.link}" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Live ↗
        </a>`
      );
    }
    elLinks.innerHTML = links.join('');
    elCaseStudy.href  = `/projects/${data.slug}`;

    modal.showModal();
    closeBtn.focus();
  }

  function closeModal() {
    modal.close();
  }

  // Tile click
  document.querySelectorAll<HTMLButtonElement>('.project-tile').forEach((tile) => {
    tile.addEventListener('click', () => {
      const raw = tile.getAttribute('data-project');
      if (!raw) return;
      try {
        const data = JSON.parse(raw);
        openModal(data);
      } catch {
        /* malformed data — ignore */
      }
    });
  });

  // Close button
  closeBtn?.addEventListener('click', closeModal);

  // Click outside (backdrop)
  modal?.addEventListener('click', (e) => {
    const rect = modal.getBoundingClientRect();
    const outside =
      e.clientX < rect.left  ||
      e.clientX > rect.right ||
      e.clientY < rect.top   ||
      e.clientY > rect.bottom;
    if (outside) closeModal();
  });

  // ESC key is handled natively by <dialog>
</script>
